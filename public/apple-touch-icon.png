<svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Apple Touch Icon 电脑版 -->
  <defs>
    <linearGradient id="orangeGradientLarge" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FB923C;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#EA580C;stop-opacity:1" />
    </linearGradient>
    
    <linearGradient id="screenGradientLarge" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FED7AA;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FCD34D;stop-opacity:1" />
    </linearGradient>
    
    <filter id="shadowLarge" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="4"/>
      <feOffset dx="0" dy="4" result="offsetblur"/>
      <feFlood flood-color="#000000" flood-opacity="0.15"/>
      <feComposite in2="offsetblur" operator="in"/>
      <feMerge>
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- 背景圆角矩形 -->
  <rect x="20" y="20" width="140" height="140" rx="45" fill="url(#orangeGradientLarge)" filter="url(#shadowLarge)"/>
  
  <!-- 电脑显示器 -->
  <g transform="translate(90, 90)">
    <!-- 显示器外框 -->
    <rect x="-40" y="-25" width="80" height="50" rx="4" fill="white" stroke="white" stroke-width="2"/>
    
    <!-- 屏幕 -->
    <rect x="-36" y="-21" width="72" height="42" rx="2" fill="url(#screenGradientLarge)"/>
    
    <!-- 屏幕内容 - 数据图表 -->
    <g opacity="0.7">
      <!-- 柱状图 -->
      <rect x="-26" y="8" width="8" height="12" fill="#EA580C"/>
      <rect x="-14" y="2" width="8" height="18" fill="#FB923C"/>
      <rect x="-2" y="5" width="8" height="15" fill="#EA580C"/>
      <rect x="10" y="0" width="8" height="20" fill="#FB923C"/>
      <rect x="22" y="6" width="8" height="14" fill="#EA580C"/>
      
      <!-- 网格线 -->
      <line x1="-30" y1="-5" x2="30" y2="-5" stroke="white" stroke-width="1" opacity="0.3"/>
      <line x1="-30" y1="12" x2="30" y2="12" stroke="white" stroke-width="1" opacity="0.3"/>
    </g>
    
    <!-- 显示器底座 -->
    <rect x="-6" y="25" width="12" height="8" fill="white"/>
    <rect x="-18" y="33" width="36" height="6" rx="3" fill="white"/>
    
    <!-- 顶部状态指示灯 -->
    <circle cx="28" cy="-21" r="4" fill="#10B981"/>
    <circle cx="28" cy="-21" r="6" fill="none" stroke="#10B981" stroke-width="1" opacity="0.3"/>
  </g>
  
  <!-- 顶部高光 -->
  <ellipse cx="90" cy="50" rx="35" ry="12" fill="white" opacity="0.2"/>
</svg>